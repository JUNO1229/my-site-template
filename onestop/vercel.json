{
  "framework": null,
  "buildCommand": "node build-demo.js && cp 원스탑서비스-체험판.html public/demo.html",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{server.js,lib/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/docs/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}